# ==========================================================
# VPS PRODUCTION — Sambal Joelid Web/API
# Simpan di: /var/www/sambal-joelid/.env
# Jangan commit file .env asli ke Git.
# ==========================================================
NODE_ENV=production
PORT=3001
CUSTOMER_MODULE_DB_PATH=/var/lib/sambal-joelid/customer-module.sqlite
JWT_SECRET=generate-a-long-random-value-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@joelid.hontalk.my.id
ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=https://joelid.hontalk.my.id,https://admin.joelid.hontalk.my.id

# WAHA hanya di loopback VPS
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=generate-a-different-long-random-value
WAHA_WEBHOOK_SECRET=generate-another-long-random-value
WAHA_SESSION_NAME=sambal-joelid

# Isi setelah tunnel model Termux tersedia (local SLM). URL harus berakhir dengan /v1.
AI_BASE_URL=https://your-termux-tunnel.example.com/v1
AI_API_KEY=protect-the-public-tunnel-with-a-bearer-key
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_MS=90000

# Groq Cloud Multi-Account Fallback
GROQ_ENABLED=true
# Masukkan API Key Groq (pisahkan koma untuk multi-akun failover, contoh: gsk_key1,gsk_key2,gsk_key3)
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=12000
GROQ_COOLDOWN_SECONDS=60
WHATSAPP_DEBOUNCE_MS=4000
WHATSAPP_REPLY_DELAY_MIN_MS=1000
WHATSAPP_REPLY_DELAY_MAX_MS=3000
LLM_HEALTH_CHECK_MS=120000
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=8
WHATSAPP_MESSAGE_RETENTION_DAYS=30
WHATSAPP_ADMIN_PAUSE_SECONDS=180

# Google Sheets CSV hanya untuk import manual/opsional. DB adalah master menu.
MENU_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRPYK4IWDOYb3qACH2dZb1MRI8vC3Dx2G6BADd5LbORAiF1wVyT7_69q7VsghdHiswxjpK_A8PHPMcl/pub?output=csv
MENU_CACHE_SECONDS=60
MENU_CSV_IMPORT_ON_START=false

# Isi setelah klien memberikan rekening transfer.
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=

# ==========================================================
# TERMUX NOTE
# Konfigurasi Telegram/Termux TIDAK berada di repository ini.
# Saat kembali ke Termux, gunakan file:
# D:\bot_honey\telegram_personal_ai\.env
# Jangan menyalin variable VPS ini ke konfigurasi Termux.
# ==========================================================
