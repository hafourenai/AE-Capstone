# ==========================================================
# VPS PRODUCTION — Sambal Joelid Web/API
# Simpan di: /var/www/sambal-joelid/.env
# Jangan commit file .env asli ke Git.
# ==========================================================
NODE_ENV=production
PORT=3001
CUSTOMER_MODULE_DB_PATH=/var/lib/sambal-joelid/customer-module.sqlite
JWT_SECRET=generate-a-long-random-value-with-openssl-rand-hex-32
ADMIN_EMAIL=admin@joelid.hontalk.my.id
ADMIN_PASSWORD=replace-with-a-strong-unique-password
CORS_ORIGINS=https://joelid.hontalk.my.id

# WAHA hanya di loopback VPS
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=generate-a-different-long-random-value
WAHA_WEBHOOK_SECRET=generate-another-long-random-value
WAHA_SESSION_NAME=sambal-joelid

# Isi setelah tunnel model Termux tersedia. URL harus berakhir dengan /v1.
AI_BASE_URL=https://your-termux-tunnel.example.com/v1
AI_API_KEY=protect-the-public-tunnel-with-a-bearer-key
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_MS=90000
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=8
WHATSAPP_MESSAGE_RETENTION_DAYS=30

# ==========================================================
# TERMUX NOTE
# Konfigurasi Telegram/Termux TIDAK berada di repository ini.
# Saat kembali ke Termux, gunakan file:
# D:\bot_honey\telegram_personal_ai\.env
# Jangan menyalin variable VPS ini ke konfigurasi Termux.
# ==========================================================
