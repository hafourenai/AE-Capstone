# Salin ke /opt/waha/.env, chmod 600, dan jangan commit nilai aslinya.
# API menerima plain key melalui X-Api-Key. Untuk hash-at-rest, ikuti runbook.
WAHA_API_KEY=replace-with-the-same-plain-key-as-api-env
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-separate-strong-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-an-unused-random-password
WHATSAPP_HOOK_HMAC_KEY=replace-with-the-same-webhook-secret-as-api-env
WHATSAPP_START_SESSION=sambal-joelid
WHATSAPP_RESTART_ALL_SESSIONS=True
