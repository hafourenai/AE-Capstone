# API
PORT=3001
CUSTOMER_MODULE_DB_PATH=./data/customer-module.sqlite
# Dataset hasil pelabelan admin. Simpan di direktori runtime yang tidak dilacak Git.
TEST_SET_PATH=./data/admin-labeled-testset.jsonl
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@sambaljoelid.local
ADMIN_PASSWORD=change-this-before-production
CORS_ORIGINS=http://localhost:5173

# WAHA (VPS/local Docker)
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=replace-with-a-long-random-key
WAHA_WEBHOOK_SECRET=replace-with-another-long-random-key
WAHA_SESSION_NAME=sambal-joelid

# OpenAI-compatible Qwen server (Termux tunnel / local SLM)
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_API_KEY=
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_MS=90000

# Groq Cloud Multi-Account Fallback (Free-tier / Production)
GROQ_ENABLED=true
# Masukkan API Key Groq (pisahkan koma jika punya beberapa akun/key, akun 1 habis -> pindah akun 2 -> akun 3)
GROQ_API_KEYS=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=12000
GROQ_COOLDOWN_SECONDS=60
WHATSAPP_DEBOUNCE_MS=4000
WHATSAPP_REPLY_DELAY_MIN_MS=1000
WHATSAPP_REPLY_DELAY_MAX_MS=3000
LLM_HEALTH_CHECK_MS=120000
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=8
WHATSAPP_MESSAGE_RETENTION_DAYS=30
WHATSAPP_ADMIN_PAUSE_SECONDS=180

# Google Sheets CSV hanya untuk import manual/opsional. DB adalah master menu.
MENU_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRPYK4IWDOYb3qACH2dZb1MRI8vC3Dx2G6BADd5LbORAiF1wVyT7_69q7VsghdHiswxjpK_A8PHPMcl/pub?output=csv
MENU_CACHE_SECONDS=60
MENU_CSV_IMPORT_ON_START=false

# Kerangka pembayaran transfer manual (kosongkan sampai data klien tersedia)
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_HOLDER=

# Web (apps/web/.env)
VITE_API_BASE_URL=http://localhost:3001/api/v1
