# API
PORT=3001
CUSTOMER_MODULE_DB_PATH=./data/customer-module.sqlite
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@sambaljoelid.local
ADMIN_PASSWORD=change-this-before-production
CORS_ORIGINS=http://localhost:5173

# WAHA (VPS/local Docker)
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=replace-with-a-long-random-key
WAHA_WEBHOOK_SECRET=replace-with-another-long-random-key
WAHA_SESSION_NAME=sambal-joelid

# OpenAI-compatible Qwen server (Termux tunnel)
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_API_KEY=
AI_MODEL=qwen2.5-1.5b-instruct
AI_TIMEOUT_MS=90000
WHATSAPP_RATE_LIMIT_WINDOW_SECONDS=60
WHATSAPP_RATE_LIMIT_MAX_MESSAGES=8
WHATSAPP_MESSAGE_RETENTION_DAYS=30

# Web (apps/web/.env)
VITE_API_BASE_URL=http://localhost:3001/api/v1
