{
  "name": "sambal-joelid",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "npm --workspace @sambal-joelid/api run dev",
    "dev:web": "npm --workspace @sambal-joelid/web run dev",
    "start:api": "npm --workspace @sambal-joelid/api start",
    "build": "npm --workspace @sambal-joelid/web run build",
    "test": "npm --workspace @sambal-joelid/api test",
    "verify:native": "node -e \"const Database=require('better-sqlite3'); const db=new Database(':memory:'); db.close(); console.log('better-sqlite3 binding OK')\""
  }
}
